{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "summary", "claims", "evidence_ids", "policy_id"],
  "properties": {
    "case_id": {"type": "string"},
    "summary": {"type": "string", "maxLength": 80},
    "claims": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 40}},
    "evidence_ids": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "policy_id": {"type": ["string", "null"]}
  }
}
