{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "claims"],
  "properties": {
    "summary": {"type": "string", "maxLength": 72},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "enum": ["evidence_count=0", "evidence_count=1", "evidence_count=2"]
      }
    }
  }
}
